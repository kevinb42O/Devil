{
  "name": "abyss-daggers",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:champion": "node tests/champion-browser.mjs && node tests/champion-alignment-browser.mjs",
    "test:fullscreen": "node tests/fullscreen-browser.mjs",
    "test:audit-rendering": "node tests/game-audit-browser.mjs",
    "test:production": "node tests/production-browser.mjs",
    "test:startup-performance": "node tests/startup-performance-browser.mjs",
    "assets:import": "node tools/import-dd-assets.mjs",
    "test:weapon": "node tests/weapon-browser.mjs",
    "test:hand-upgrades": "tsx --test tests/hand-upgrades.test.ts && node tests/hand-upgrades-browser.mjs",
    "test:weapon-readability": "node tests/weapon-readability-browser.mjs",
    "test:enemies": "node tests/enemy-browser.mjs",
    "test:replica": "node tests/replica-browser.mjs",
    "assets:audio": "node tools/import-dd-audio.mjs",
    "test:swarm": "node tests/swarm-browser.mjs",
    "test:performance": "node tests/tower-performance-browser.mjs",
    "test:optimization": "node tests/optimization-comparison-browser.mjs",
    "profile:rendering": "node tests/optimization-browser.mjs baseline",
    "test:audio": "node tests/audio-browser.mjs",
    "test:music": "node tests/music-browser.mjs",
    "test:projectiles": "node tests/projectile-browser.mjs",
    "test:projectile-muzzle": "node tests/projectile-muzzle-browser.mjs",
    "test:blood": "node tests/blood-browser.mjs",
    "test:projectile-impacts": "node tests/projectile-impact-browser.mjs",
    "assets:colliders": "node tools/build-projectile-colliders.mjs",
    "test:projectile-lighting": "node tests/projectile-lighting-browser.mjs",
    "test:gems": "node tests/gem-browser.mjs",
    "test:enemy-lighting": "node tests/enemy-lighting-browser.mjs",
    "test:multiplayer": "node tests/multiplayer-browser.mjs",
    "test:multiplayer-pause": "node tests/multiplayer-pause-browser.mjs",
    "test:multiplayer-rooms": "node tests/multiplayer-auto-browser.mjs",
    "test:multiplayer-transport": "node tests/multiplayer-transport-browser.mjs",
    "serve:online": "node tools/serve-online.mjs",
    "test:multiplayer-presentation": "node tests/multiplayer-presentation-browser.mjs",
    "test:multiplayer-spectator": "tsx --test tests/spectator.test.ts && node tests/multiplayer-spectator-flow-browser.mjs && node tests/multiplayer-spectator-controls-browser.mjs",
    "test:controls": "node tests/controls-browser.mjs && node tests/controls-edge-browser.mjs && node tests/controller-connection-browser.mjs",
    "test:preferences": "node tests/preferences-browser.mjs",
    "test:multiplayer-latency": "node tests/multiplayer-latency-browser.mjs",
    "test:multiplayer-responsiveness": "node tests/multiplayer-responsiveness-browser.mjs",
    "test:mobile": "node tests/mobile-browser.mjs && node tests/mobile-death-browser.mjs",
    "test:death-analysis": "node tests/death-analysis-browser.mjs",
    "test:death-camera": "node tests/death-camera-browser.mjs",
    "test:death-controller": "node tests/death-analysis-controller.mjs",
    "test:death-performance": "node tests/death-analysis-performance.mjs",
    "test:multiplayer-respawn": "tsx --test tests/multiplayer-respawn.test.ts && node tests/multiplayer-respawn-browser.mjs",
    "test:gem-hud": "node tests/gem-hud-browser.mjs",
    "test:descent": "tsx --test tests/descent.test.ts && node tests/descent-browser.mjs && node tests/descent-play-browser.mjs && node tests/descent-preview-browser.mjs",
    "test:descent-performance": "node tests/descent-performance-browser.mjs",
    "test:multiplayer-recovery": "tsx --test tests/multiplayer-recovery.test.ts && node tests/multiplayer-host-clock-browser.mjs",
    "test:multiplayer-network-regressions": "tsx --test tests/multiplayer-network-regressions.test.ts && node tests/multiplayer-large-state-browser.mjs",
    "test:multiplayer-soak": "node tests/multiplayer-soak-browser.mjs",
    "test:replay-sharing": "tsx --test tests/replay-file.test.ts tests/replay.test.ts tests/score-queue.test.ts && node tests/replay-sharing-browser.mjs",
    "test:mist": "tsx --test tests/mist-state.test.ts tests/mist-light-field.test.ts && node tests/mist-distance-edge-browser.mjs && node tests/opening-mist-browser.mjs && node tests/descent-mist-browser.mjs && node tests/mist-toggle-browser.mjs",
    "test:mist-performance": "node tests/descent-mist-performance-browser.mjs",
    "test:pwa": "node tests/pwa-browser.mjs",
    "test:crew-replay": "tsx --test tests/crew-replay.test.ts tests/crew-replay-transfer.test.ts && node tests/crew-replay-browser.mjs && node tests/crew-replay-controls-browser.mjs",
    "test:crew-replay-performance": "tsx tests/crew-replay-profile.ts && tsx tests/crew-replay-dense-profile.ts",
    "test:crew-leaderboard": "tsx --test tests/crew-ranking.test.ts tests/crew-leaderboard-sql.test.mjs && node tests/crew-leaderboard-browser.mjs && node tests/crew-publication-browser.mjs",
    "test:lobby-joining": "tsx --test tests/lobby-joining.test.ts && node tests/lobby-joining-browser.mjs && LATE_ICE=1 node tests/lobby-joining-browser.mjs && node tests/lobby-mobile-browser.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
